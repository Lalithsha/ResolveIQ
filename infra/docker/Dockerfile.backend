# Multi-stage Dockerfile for ResolveIQ Spring Boot Services
FROM maven:3.9.9-eclipse-temurin-21-alpine AS dev-builder
WORKDIR /workspace
COPY . .
# Compile the reactor once while BuildKit is building the shared dev image. Every
# backend container starts its own prepared JAR instead of running seven competing
# Maven builds during `docker compose up`.
RUN --mount=type=cache,target=/root/.m2 \
    ./mvnw -q package -Dmaven.test.skip=true -Djacoco.skip=true && \
    mkdir -p /opt/resolveiq-dev-jars && \
    for service_dir in discovery-service api-gateway auth-service ticket-service \
      ai-orchestration-service ai-analysis-service routing-service rag-service; do \
      built_jar="$(find "/workspace/${service_dir}/target" -maxdepth 1 -type f -name '*.jar' ! -name '*.original' | head -n 1)"; \
      test -n "${built_jar}"; \
      cp "${built_jar}" "/opt/resolveiq-dev-jars/${service_dir}.jar"; \
      { \
        find "/workspace/${service_dir}/src/main" /workspace/common-contracts/src/main /workspace/common-security/src/main \
          -type f -exec sha256sum {} + 2>/dev/null; \
        sha256sum /workspace/pom.xml "/workspace/${service_dir}/pom.xml" \
          /workspace/common-contracts/pom.xml /workspace/common-security/pom.xml 2>/dev/null; \
      } | sort | sha256sum | cut -d ' ' -f 1 > "/opt/resolveiq-dev-jars/${service_dir}.fingerprint"; \
    done

FROM maven:3.9.9-eclipse-temurin-21-alpine AS dev
RUN apk add --no-cache ffmpeg tesseract-ocr poppler-utils
WORKDIR /workspace
COPY . .
COPY --from=dev-builder /opt/resolveiq-dev-jars /opt/resolveiq-dev-jars
ENTRYPOINT ["sh", "/workspace/infra/docker/dev-backend-entrypoint.sh"]

FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder
WORKDIR /workspace

# Cache parent and dependencies
COPY pom.xml .
COPY common-contracts/pom.xml common-contracts/
COPY common-security/pom.xml common-security/
COPY discovery-service/pom.xml discovery-service/
COPY api-gateway/pom.xml api-gateway/
COPY auth-service/pom.xml auth-service/
COPY ticket-service/pom.xml ticket-service/
COPY ai-orchestration-service/pom.xml ai-orchestration-service/
COPY ai-analysis-service/pom.xml ai-analysis-service/
COPY routing-service/pom.xml routing-service/
COPY rag-service/pom.xml rag-service/

COPY . .
RUN --mount=type=cache,target=/root/.m2 mvn clean package -DskipTests

FROM eclipse-temurin:21-jre-alpine AS prod
RUN apk add --no-cache ffmpeg tesseract-ocr poppler-utils
ARG SERVICE_NAME
WORKDIR /app
COPY --from=builder /workspace/${SERVICE_NAME}/target/*.jar app.jar

ENV JAVA_OPTS="-XX:+UseG1GC -XX:MaxRAMPercentage=75.0"
EXPOSE 8080
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
