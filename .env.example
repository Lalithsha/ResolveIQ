# ==============================================================================
# ResolveIQ Environment Configuration Template
# All values here are fictional placeholders.
# Do NOT commit real secrets or production credentials.
# ==============================================================================

# Application Profile (local, test, docker, staging, production)
SPRING_PROFILES_ACTIVE=local

# Server Ports
RESOLVEIQ_GATEWAY_PORT=8080
RESOLVEIQ_AUTH_PORT=8081
RESOLVEIQ_TICKET_PORT=8082
RESOLVEIQ_ORCH_PORT=8083
RESOLVEIQ_ANALYSIS_PORT=8084
RESOLVEIQ_ROUTING_PORT=8085
RESOLVEIQ_RAG_PORT=8086
RESOLVEIQ_DISCOVERY_PORT=8761
RESOLVEIQ_FRONTEND_PORT=3000

# PostgreSQL Database (with pgvector)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/resolveiq
SPRING_DATASOURCE_USERNAME=resolveiq_app
SPRING_DATASOURCE_PASSWORD=local_dev_password_change_in_prod
POSTGRES_DB=resolveiq
POSTGRES_USER=resolveiq_app
POSTGRES_PASSWORD=local_dev_password_change_in_prod

# Kafka Message Broker
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Object Storage (MinIO / S3)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=resolveiq_minio_dev_access
MINIO_SECRET_KEY=resolveiq_minio_dev_secret_key_12345
MINIO_BUCKET_NAME=resolveiq-attachments

# Security & JWT Tokens
RESOLVEIQ_JWT_SECRET=fictional_jwt_hmac_secret_key_minimum_256_bits_for_local_development_only_12345
RESOLVEIQ_JWT_EXPIRATION_MS=900000
RESOLVEIQ_JWT_REFRESH_EXPIRATION_MS=604800000

# AI Provider Configuration
# Supported providers: ollama, openai, gemini, mock
RESOLVEIQ_AI_CHAT_PROVIDER=mock
RESOLVEIQ_AI_CHAT_MODEL=mock-model-v1
RESOLVEIQ_AI_EMBEDDING_PROVIDER=mock
RESOLVEIQ_AI_EMBEDDING_MODEL=mock-embedding-v1
RESOLVEIQ_AI_API_KEY=mock-api-key-for-local-testing

# Local Ollama Provider (optional for local LLM inference)
RESOLVEIQ_OLLAMA_BASE_URL=http://localhost:11434

# Observability (OpenTelemetry / Prometheus)
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
OTEL_SERVICE_NAME=resolveiq-platform
